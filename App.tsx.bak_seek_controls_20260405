                <div className="space-y-[3.5%]">
                  <h3 className="text-[1.45vw] font-black uppercase">Colabore conosco</h3>
                  <p className="text-[1vw] leading-[1.45] text-white/90">
                    Voce pode colaborar com este projeto com uma doacao ou enviando sugestoes de melhoria.
                  </p>
                  <p className="text-[0.95vw] leading-[1.45] text-white/75">
                    QR code placeholder (ainda sem destino especifico):
                  </p>
                  <div className="w-[34%] min-w-[180px] aspect-square rounded-[0.7vw] bg-white p-[4%]">
                    <div
                      className="w-full h-full"
                      style={{
                        backgroundImage:
                          'linear-gradient(90deg,#111 50%,#fff 50%), linear-gradient(#111 50%,#fff 50%)',
                        backgroundSize: '16px 16px',
                        border: '2px solid #111',
                      }}
                    />
                  </div>
                </div>
              )}
            </div>
          </section>
        </>
      )}

      <main className="relative z-10 flex-1 min-h-0 box-border px-[2.2%] pb-[2%] pt-[0.5%] grid grid-cols-[14%_86%] gap-[1.4%]">
        <aside className="border-r border-white/20 pr-[6%] min-w-0 min-h-0 flex flex-col">
          <div className="text-[2vw] font-black leading-none tabular-nums">{clockLabel}</div>
          <div className="mt-[1.2%] text-sky-100/80 text-[0.75vw] uppercase tracking-[0.2em]">{dateLabel}</div>

          <div className="mt-[8%] text-sky-200/80 text-[1.7vw] font-semibold">Categorias</div>
          <div className="mt-[2%] space-y-[1.2%] overflow-y-auto">
            {availableCategories.length === 0 ? (
              <div className="text-[0.95vw] text-white/60">Sem categorias na playlist</div>
            ) : (
              availableCategories.map(cat => (
                <button
                  key={cat.id}
                  type="button"
                  onClick={() => {
                    setSelectedCategory(cat.id);
                    const idx = state.channels.findIndex(ch => getChannelCategory(ch) === cat.id);
                    if (idx >= 0) selectChannel(idx);
                  }}
                  className={[
                    'w-full text-left px-[5%] py-[3.5%] rounded-[0.6vw] text-[1.1vw] font-bold uppercase transition-colors',
                    selectedCategory === cat.id
                      ? 'bg-white text-[#0a1d80]'
                      : 'text-white/85 hover:bg-white/10',
                  ].join(' ')}
                >
                  {cat.label}
                </button>
              ))
            )}
          </div>

          <div className="mt-auto pt-[6%] text-[0.9vw] text-white/70">
            Hover no card: preview ao vivo | Enter/click: tela grande
          </div>
        </aside>

        <section className="min-w-0 min-h-0 flex flex-col overflow-hidden">
          <div className="mb-[1.2%] flex items-center justify-between gap-[1%]">
            <div className="flex items-center gap-[1%] min-w-0">
              <h2 className="text-[1.65vw] font-black uppercase tracking-wide truncate">Mais populares</h2>
              <span className="text-[0.82vw] text-white/70 shrink-0">{popularCards.length} canais</span>
            </div>
            <div className="flex items-center gap-[0.5%]">
              <button
                type="button"
                onClick={() => scrollCarousel(-1)}
                className="w-[2.2vw] h-[2.2vw] rounded-full border border-white/20 bg-white/5 hover:bg-white/15"
                aria-label="Canal anterior"
              >
                {'<'}
              </button>
              <button
                type="button"
                onClick={() => scrollCarousel(1)}
                className="w-[2.2vw] h-[2.2vw] rounded-full border border-white/20 bg-white/5 hover:bg-white/15"
                aria-label="Próximo canal"
              >
                {'>'}
              </button>
            </div>
          </div>

          <div
            ref={carouselViewportRef}
            className="overflow-x-auto overflow-y-hidden pb-[0.8%]"
          >
            <div className="flex gap-[0.8vw] w-max items-center">
              {shouldLoopCarousel ? (
                Array.from({ length: 3 }).map((_, segmentIndex) => (
                  <div
                    key={`seg-${segmentIndex}`}
                    ref={segmentIndex === 0 ? carouselSegmentRef : null}
                    data-carousel-segment={segmentIndex}
                    className="flex gap-[0.8vw] shrink-0 items-center"
                  >
                    {popularCards.map((chIdx, pos) => {
                      const ch = state.channels[chIdx];
                      const isSelected = chIdx === state.currentChannelIndex;
                      return (
                        <button
                          key={`chip-${segmentIndex}-${pos}-${chIdx}`}
                          type="button"
                          data-popular-chip="1"
                          data-popular-channel-idx={chIdx}
                          onClick={() => openChannelLarge(chIdx)}
                          className={[
                            'shrink-0 min-w-max inline-flex items-center whitespace-nowrap leading-none select-none px-[1.25vw] py-[0.5vw] rounded-[0.8vw] text-[0.95vw] font-extrabold uppercase border transition-colors',
                            isSelected
                              ? 'bg-white text-[#0a1d80] border-white'
                              : 'bg-white/10 text-white border-white/10 hover:bg-white/20',
                          ].join(' ')}
                        >
                          {ch.name}
                        </button>
                      );
                    })}
                  </div>
                ))
              ) : (
                <div
                  ref={carouselSegmentRef}
                  data-carousel-segment={0}
                  className="flex gap-[0.8vw] shrink-0 items-center"
                >
                  {popularCards.map((chIdx, pos) => {
                    const ch = state.channels[chIdx];
                    const isSelected = chIdx === state.currentChannelIndex;
                    return (
                      <button
                        key={`chip-0-${pos}-${chIdx}`}
                        type="button"
                        data-popular-chip="1"
                        data-popular-channel-idx={chIdx}
                        onClick={() => openChannelLarge(chIdx)}
                        className={[
                          'shrink-0 min-w-max inline-flex items-center whitespace-nowrap leading-none select-none px-[1.25vw] py-[0.5vw] rounded-[0.8vw] text-[0.95vw] font-extrabold uppercase border transition-colors',
                          isSelected
                            ? 'bg-white text-[#0a1d80] border-white'
                            : 'bg-white/10 text-white border-white/10 hover:bg-white/20',
                        ].join(' ')}
                      >
                        {ch.name}
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          </div>

          <div className="mt-[1.5%] mb-[0.8%] flex items-center justify-between gap-[1%]">
            <h3 className="text-[1.35vw] font-black uppercase tracking-wide truncate">
              {categoryCards.length ? selectedCategory : 'Mais assistidos'}
            </h3>
            <span className="text-[0.82vw] text-white/70 shrink-0">{cards.length} cards</span>
          </div>

          <div
            ref={cardsViewportRef}
            className="flex-1 min-h-0 overflow-y-auto overflow-x-hidden pr-[0.6%] pb-[1.2%] snap-y snap-mandatory"
          >
            <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 items-start gap-x-[1.2%] gap-y-[1.2vh]">
              {cards.map((chIdx) => renderChannelCard(chIdx, `grid-${chIdx}`))}
            </div>
          </div>
        </section>
      </main>

      {expandedPlayback && expandedChannel && expandedItem && (
        <div ref={fullscreenShellRef} className="fixed inset-0 z-50 bg-black" onMouseMove={showExpandedInfo} onMouseEnter={showExpandedInfo} onClick={showExpandedInfo}>
          <div className="absolute right-[1.2%] top-1/2 -translate-y-1/2 z-50 flex flex-col gap-[0.8%]">
            <button
              type="button"
              onClick={() => changeExpandedChannel(-1)}
              className="w-[2.9vw] h-[2.9vw] rounded-full border border-white/25 bg-black/50 hover:bg-black/70 text-[1vw]"
              aria-label="Canal acima"
            >
              {'^'}
            </button>
            <button
              type="button"
              onClick={() => changeExpandedChannel(1)}
              className="w-[2.9vw] h-[2.9vw] rounded-full border border-white/25 bg-black/50 hover:bg-black/70 text-[1vw]"
              aria-label="Canal abaixo"
            >
              {'v'}
            </button>
          </div>
          <div className="w-full h-full relative">
            {expandedItem.type === ContentType.AD ? (
              <AdPlaceholder
                duration={Math.max(0, expandedItem.duration - expandedPlayback.playback.offset)}
                onEnded={advanceExpandedPlayback}
              />
            ) : (
              <>
                {(expandedChannel.kind === ChannelKind.YOUTUBE || expandedChannel.kind === ChannelKind.YOUTUBE_LINEAR) ? (
                  <YouTubePlayer
                    key={`expanded-${expandedChannel.channel_id}-${expandedPlayback.playback.index}`}
                    url={expandedItem.url!}
                    offset={expandedPlayback.playback.offset}
                    duration={expandedItem.duration}
                    onEnded={advanceExpandedPlayback}
                  />
                ) : (
                  <HLSPlayer
                    key={`expanded-${expandedChannel.channel_id}-${expandedPlayback.playback.index}`}
                    url={expandedItem.url!}
                    offset={expandedPlayback.playback.offset}
                    onEnded={advanceExpandedPlayback}
                  />
                )}
              </>
            )}
            <BannerSticker banner={activeBannerAd} isVisible={isBannerAdVisible} />
            <div
              className={[
                'pointer-events-none absolute inset-0 transition-opacity duration-300',
                isExpandedInfoVisible ? 'opacity-100' : 'opacity-0',
              ].join(' ')}
            >
              <div className="absolute top-0 left-0 right-0 bg-gradient-to-b from-black/80 to-transparent p-[1.2%]">
                <div className="inline-flex items-center gap-[0.8%] rounded-[0.8vw] border border-white/25 bg-black/45 px-[1%] py-[0.5%]">
                  <span className="rounded-full bg-[#2d4df7] px-[0.8%] py-[0.3%] text-[0.9vw] font-black">
                    {formatChannelNumber(expandedChannel, expandedPlayback.channelIndex)}
                  </span>
                  <span className="text-[1.2vw] font-extrabold">{expandedChannel.name}</span>
                </div>
              </div>
              <div className="absolute left-0 right-0 bottom-0 bg-gradient-to-t from-black/85 to-transparent p-[1.2%]">
                <div className="max-w-[60%] rounded-[0.8vw] border border-white/20 bg-black/45 px-[1%] py-[0.8%]">
                  <div className="text-[0.8vw] uppercase tracking-[0.16em] text-sky-300">Agora</div>
                  <div className="text-[1vw] font-bold truncate">{getItemLabel(expandedItem)}</div>
                  {expandedItem.duration > 0 && (
                    <div className="mt-[0.8vh]">
                      <div className="overflow-hidden rounded-full border border-cyan-300/70 bg-white/10 p-[0.14vh] shadow-[0_0_0_0.08vw_rgba(34,211,238,0.25)] backdrop-blur-[2px]">
                        <div className="h-[0.42vh] overflow-hidden rounded-full bg-white/15">
                          <div
                            className="h-full rounded-full bg-[repeating-linear-gradient(135deg,rgba(34,211,238,0.96)_0,rgba(34,211,238,0.96)_0.38vw,rgba(255,255,255,0.26)_0.38vw,rgba(255,255,255,0.26)_0.58vw)] shadow-[0_0_0.85vw_rgba(34,211,238,0.35)]"
                            style={{ width: `${expandedProgress.percent}%` }}
                          />
                        </div>
                      </div>
                      <div className="mt-[0.35vh] text-[0.72vw] text-cyan-50/82">
                        {expandedProgress.elapsedLabel} / {expandedProgress.durationLabel}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default App;





